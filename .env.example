# Supabase — required for all features that talk to the database.
# Copy these from https://supabase.com/dashboard/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Demo mode — the demo shopping flow (demo_products, demo_orders) is
# opt-in. Set this to "true" locally if you want to exercise the cart and
# checkout UI against the demo tables without live payments.
NEXT_PUBLIC_DEMO_MODE=false

# Stripe (planned — not yet wired into checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Razorpay (planned — not yet wired into checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETPLACE_NAME=ShilpKart
NEXT_PUBLIC_MARKETPLACE_COMMISSION_RATE=30
